# 本文件仅说明配置；Compose 使用固定本地入口并在私有命名卷生成凭据。
# 独立启动后端时通过进程环境注入；加载器拒绝占位值，不自动读取本文件。
APP_HOST=127.0.0.1
APP_PORT=5173
APP_ORIGIN=http://127.0.0.1:5173
DJANGO_SECRET_KEY=__SET_LOCALLY__
DATABASE_URL=__SET_LOCAL_DATABASE_URL__
CELERY_BROKER_URL=__SET_LOCAL_BROKER_URL__
# 秘密可以通过对应文件变量注入；同一秘密的值与文件配置不能同时存在。
# DJANGO_SECRET_KEY_FILE=__SET_LOCAL_SECRET_FILE__
# DATABASE_PASSWORD_FILE=__SET_LOCAL_SECRET_FILE__

# 模型可选；未填写地址和模型时不可提交，启动不会自动调用。
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# 模型可选覆盖配置只给 Worker 挂载密钥；不要将实际值写入本文件。
# MODEL_API_KEY_FILE=__SET_LOCAL_SECRET_FILE__

# 防御性默认值的权威说明位于后端规范，尚不是产品运行保证。
IMPORT_MAX_ARCHIVE_BYTES=20971520
IMPORT_MAX_DECLARED_BYTES=104857600
IMPORT_MAX_EXTRACTED_BYTES=104857600
IMPORT_MAX_ENTRIES=5000
IMPORT_MAX_SOURCE_FILES=2000
IMPORT_MAX_SOURCE_BYTES=1048576
WORKER_CONCURRENCY=1
JOB_QUEUE_TIMEOUT_SECONDS=300
JOB_EXECUTION_TIMEOUT_SECONDS=300
